{
  "description": "The MacropaySolutions Kernel Console package.",
  "license": "MIT",
  "require": {
    "php": "^8.1",
    "ext-mbstring": "*",
    "nunomaduro/termwind": "^1.13",
    "symfony/console": "^6.2",
    "symfony/process": "^6.2"
  },
  "autoload": {
    "psr-4": {
      "MacropaySolutions\\Kernel\\Console\\": ""
    }
  },
  "suggest": {
    "ext-pcntl": "Required to use signal trapping.",
    "dragonmantank/cron-expression": "Required to use scheduler (^3.3.2).",
    "guzzlehttp/guzzle": "Required to use the ping methods on schedules (^7.5)."
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "dev"
}
