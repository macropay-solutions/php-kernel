{
    "name": "macropay-solutions/php-kernel",
    "description": "The Macropay-Solutions PHP Kernel",
    "keywords": ["framework", "macropay-solutions"],
    "license": "MIT",
    "type": "library",
    "support": {
        "issues": "https://github.com/macropay-solutions/php-kernel/issues",
        "source": "https://github.com/macropay-solutions/php-kernel"
    },
    "require": {
        "composer-runtime-api": "^2.2",
        "doctrine/inflector": "^2.0",
        "dragonmantank/cron-expression": "^3.6",
        "egulias/email-validator": "^4.0",
        "ext-bcmath": "*",
        "ext-ctype": "*",
        "ext-filter": "*",
        "ext-hash": "*",
        "ext-intl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "ext-session": "*",
        "ext-tokenizer": "*",
        "fruitcake/php-cors": "^1.3",
        "guzzlehttp/uri-template": "^1.0",
        "monolog/monolog": "^3.0",
        "nesbot/carbon": "^3.11",
        "php": "^8.2",
        "psr/container": "^1.1.1|^2.0.1",
        "psr/simple-cache": "^1.0|^2.0|^3.0",
        "psr/log": "^1.0|^2.0|^3.0",
        "ramsey/uuid": "^4.7",
        "symfony/console": "^7.4",
        "symfony/error-handler": "^7.4",
        "symfony/finder": "^7.4",
        "symfony/http-foundation": "^7.4",
        "symfony/http-kernel": "^7.4",
        "symfony/mime": "^7.4",
        "symfony/process": "^7.4",
        "symfony/var-dumper": "^7.4",
        "vlucas/phpdotenv": "^5.6.3",
        "voku/portable-ascii": "^2.0"
    },
    "conflict": {
        "illuminate/auth": "*",
        "illuminate/broadcasting": "*",
        "illuminate/bus": "*",
        "illuminate/cache": "*",
        "illuminate/collections": "*",
        "illuminate/conditionable": "*",
        "illuminate/config": "*",
        "illuminate/console": "*",
        "illuminate/container": "*",
        "illuminate/contracts": "*",
        "illuminate/cookie": "*",
        "illuminate/database": "*",
        "illuminate/encryption": "*",
        "illuminate/events": "*",
        "illuminate/filesystem": "*",
        "illuminate/hashing": "*",
        "illuminate/http": "*",
        "illuminate/log": "*",
        "illuminate/macroable": "*",
        "illuminate/mail": "*",
        "illuminate/notifications": "*",
        "illuminate/pagination": "*",
        "illuminate/pipeline": "*",
        "illuminate/process": "*",
        "illuminate/queue": "*",
        "illuminate/redis": "*",
        "illuminate/routing": "*",
        "illuminate/session": "*",
        "illuminate/support": "*",
        "illuminate/translation": "*",
        "illuminate/validation": "*",
        "illuminate/view": "*"
    },
    "require-dev": {
        "league/commonmark": "^2.6",
        "mockery/mockery": "^1.6.12",
        "phpunit/phpunit": "^11.5 || ^12.0",
        "macropay-solutions/php-kernel-dev": "^1.0.0",
        "nikic/fast-route": "^1.3",
        "symfony/mailer": "^7.4",
        "symfony/routing": "^7.4",
        "tijsverkoyen/css-to-inline-styles": "^2.2.5"
    },
    "provide": {
        "psr/container-implementation": "1.1|2.0",
        "psr/simple-cache-implementation": "1.0|2.0|3.0"
    },
    "suggest": {
        "php": "8.2-8.4",
        "ext-pcntl": "*",
        "ext-posix": "*",
        "ext-redis": "*",
        "league/commonmark": "Required for Markdown mailables (^2.6)",
        "macropay-solutions/php-crufd-wizard": "*",
        "macropay-solutions/php-crufd-wizard-decorator": "*",
        "macropay-solutions/php-crufd-wizard-client": "*",
        "macropay-solutions/php-crufd-wizard-generator": "*",
        "nikic/fast-route": "^1.3",
        "symfony/mailer": "Required to send emails (^7.4)",
        "symfony/routing": "^7.4",
        "tijsverkoyen/css-to-inline-styles": "Required for HTML email styling (^2.2.5)"
    },
    "autoload": {
        "psr-4": {
            "MacropaySolutions\\Framework\\": "src/",
            "MacropaySolutions\\Kernel\\": "kernel/",
            "MacropaySolutions\\Kernel\\Support\\": [
                "kernel/Macroable/",
                "kernel/Collections/",
                "kernel/Conditionable/"
            ],
            "MacropaySolutions\\Prompts\\": "prompts/src/"
        },
        "files": [
            "kernel/Collections/helpers.php",
            "kernel/Events/functions.php",
            "kernel/Filesystem/functions.php",
            "kernel/Support/helpers.php",
            "src/helpers.php"
        ]
    },
    "extra": {
        "publish-assets": {
            "config/app.php": "config/app.php",
            "config/auth.php": "config/auth.php",
            "config/broadcasting.php": "config/broadcasting.php",
            "config/cache.php": "config/cache.php",
            "config/database.php": "config/database.php",
            "config/filesystems.php": "config/filesystems.php",
            "config/logging.php": "config/logging.php",
            "config/queue.php": "config/queue.php",
            "config/services.php": "config/services.php",
            "config/session.php": "config/session.php",
            "config/view.php": "config/view.php",
            "kernel/Translation/lang": "resources/lang",
            "kernel/Mail/resources/views": "resources/views/vendor/mail",
            "kernel/Notifications/resources/views": "resources/views/vendor/notifications",
            "kernel/Pagination/resources/views": "resources/views/vendor/pagination"
        }
    },
    "minimum-stability": "RC",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "macropay-solutions/php-kernel-dev": true
        }
    }
}
