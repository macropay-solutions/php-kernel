{
  "name": "illuminate/config",
  "description": "The Illuminate Config package.",
  "license": "MIT",



  "require": {
    "php": "^8.1"
  },
  "suggest": {
    "illuminate/collections": "^10.0",
    "illuminate/contracts": "^10.0"
  },
  "autoload": {
    "psr-4": {
      "Illuminate\\Config\\": ""
    }
  },
  "extra": {
    "branch-alias": {
      "dev-master": "10.x-dev"
    }
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "dev"
}
