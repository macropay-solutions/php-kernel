{
  "name": "illuminate/container",
  "description": "The Illuminate Container package.",
  "license": "MIT",



  "require": {
    "php": "^8.1",
    "psr/container": "^1.1.1|^2.0.1"
  },
  "suggest": {
    "illuminate/contracts": "^10.0"
  },
  "provide": {
    "psr/container-implementation": "1.1|2.0"
  },
  "autoload": {
    "psr-4": {
      "Illuminate\\Container\\": ""
    }
  },
  "extra": {
    "branch-alias": {
      "dev-master": "10.x-dev"
    }
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "dev"
}
